# Obrigatorias
DATABASE_URL=postgresql://customer:customer@localhost:5433/customer?schema=public
KAFKA_BROKER=localhost:9092

# Opcionais (valores padrao)
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
KAFKA_CLIENT_ID=ms-customer
KAFKA_SEND_TIMEOUT_MS=5000
# Replay: group temporario fixo (ex.: ms-customer.transport-type-sync.replay-20260928)
TRANSPORT_SYNC_GROUP_ID=ms-customer.transport-type-sync
CONSUMER_RETRY_RETRIES=5
CONSUMER_RETRY_INITIAL_MS=300
CONSUMER_RETRY_MAX_MS=30000
CONSUMER_PAUSE_MS=30000
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_MS=30000
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=100
HEALTH_CHECK_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000

# So para autoria de migration (prisma migrate dev --create-only)
# SHADOW_DATABASE_URL=postgresql://customer:customer@localhost:5433/customer_shadow?schema=public
